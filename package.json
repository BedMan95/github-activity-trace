{
  "name": "github-activity-trace",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "build:next": "next build && node scripts/copy-standalone-assets.cjs",
    "build:electron": "npm run build:next && electron-builder",
    "build:electron:dir": "npm run build:next && electron-builder --dir",
    "build:electron:linux": "npm run build:next && electron-builder --linux tar.gz zip",
    "build:electron:linux:pkg": "npm run build:next && electron-builder --linux AppImage deb",
    "build:electron:linux:dir": "npm run build:next && electron-builder --linux --dir",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "electron": "electron .",
    "electron:dev": "concurrently -k -s first \"npm run dev\" \"wait-on -t 60000 tcp:3002 && electron .\"",
    "electron:prod": "electron ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "date-fns": "^4.4.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.githubactivitytrace.app",
    "productName": "GitHub Activity Trace",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "tar.gz",
        "zip"
      ],
      "category": "Development"
    }
  }
}
